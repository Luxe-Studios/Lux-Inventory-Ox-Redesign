diff --git a/web/src/components/utils/SegmentBar.tsx b/web/src/components/utils/SegmentBar.tsx
new file mode 100644
index 0000000..63442f4
--- /dev/null
+++ b/web/src/components/utils/SegmentBar.tsx
@@ -0,0 +1,16 @@
+import React from 'react';
+
+// Luxe Clean Inventory: weight shown as 10 segments
+const SegmentBar: React.FC<{ percent: number }> = ({ percent }) => {
+  const filled = Math.min(10, Math.ceil(Math.max(0, percent) / 10));
+  const state = percent >= 90 ? ' ci-full' : percent >= 70 ? ' ci-heavy' : '';
+  return (
+    <div className={`ci-segments${state}`}>
+      {Array.from({ length: 10 }, (_, i) => (
+        <span key={i} className={i < filled ? 'on' : ''} />
+      ))}
+    </div>
+  );
+};
+
+export default SegmentBar;
