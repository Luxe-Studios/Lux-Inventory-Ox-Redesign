index 0000000..9e77e0d
--- /dev/null
+++ b/web/src/components/inventory/StatusColumn.tsx
@@ -0,0 +1,43 @@
+import React from 'react';
+import { useLuxeStatus } from '../../luxe/luxe';
+
+const ICONS: Record<string, React.ReactNode> = {
+  health: <path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.7 4.5c2.1 0 3.6 1.2 5.3 3.1 1.7-1.9 3.2-3.1 5.3-3.1 3.7 0 5.8 3.9 4.3 7.3C19.5 16.4 12 21 12 21z" />,
+  armour: <path d="M12 2.5l8 3v6.2c0 5-3.4 8.6-8 9.8-4.6-1.2-8-4.8-8-9.8V5.5l8-3zm0 2.1v14.8c3.5-1.1 6-4 6-7.7V6.9l-6-2.3z" />,
+  hunger: (
+    <path d="M6 2.5v7a2.5 2.5 0 0 0 2 2.45V21.5h2V11.95A2.5 2.5 0 0 0 12 9.5v-7h-1.6v6.2h-1V2.5H7.9v6.2H7V2.5H6zm10.5 0c-1.7 0-3 2.1-3 5.3 0 2.3.9 3.6 2 4V21.5h2v-19h-1z" />
+  ),
+  thirst: <path d="M12 2.5S5.5 9.6 5.5 14.3A6.5 6.5 0 0 0 12 21a6.5 6.5 0 0 0 6.5-6.7C18.5 9.6 12 2.5 12 2.5z" />,
+};
+
+const StatusColumn: React.FC = () => {
+  const status = useLuxeStatus();
+  if (!status) return null;
+  const rows: Array<[string, number]> = [
+    ['health', status.health],
+    ['armour', status.armour],
+    ['hunger', status.hunger],
+    ['thirst', status.thirst],
+  ];
+  return (
+    <div className="ci-status">
+      {rows.map(([key, value]) => {
+        const v = Math.max(0, Math.min(100, Math.round(value ?? 0)));
+        const low = key !== 'armour' && v <= 20;
+        return (
+          <div key={key} className={`ci-status-tile ci-status-${key}${low ? ' ci-low' : ''}`} style={{ ['--v' as any]: v }}>
+            <svg viewBox="0 0 24 24" className="ci-status-icon">
+              {ICONS[key]}
+            </svg>
+            <span className="ci-status-value">{v}%</span>
+            <span className="ci-status-bar">
+              <i />
+            </span>
+          </div>
+        );
+      })}
+    </div>
+  );
+};
+
+export default StatusColumn;
