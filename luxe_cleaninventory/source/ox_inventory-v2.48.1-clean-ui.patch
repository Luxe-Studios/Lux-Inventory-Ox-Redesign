@@ -0,0 +1,196 @@
+// Luxe Clean Inventory - clean, neutral look matching Luxe Clean HUD
+@font-face { font-family: 'LuxeClean'; src: url('./fonts/Poppins-Medium.ttf'); font-weight: 400 500; }
+@font-face { font-family: 'LuxeClean'; src: url('./fonts/Poppins-Bold.ttf'); font-weight: 600 700; }
+
+:root {
+  --ci-accent: #e8e6e1;
+  --ci-on-accent: #141416;
+  --ci-text: #f1efea;
+  --ci-muted: #8d8b86;
+  --ci-bg: rgba(18, 18, 20, 0.62);
+  --ci-slot: rgba(18, 18, 20, 0.55);
+  --ci-slot-hover: rgba(40, 40, 44, 0.7);
+  --ci-solid: rgba(22, 22, 24, 0.97);
+  --ci-line: rgba(255, 255, 255, 0.07);
+  --ci-track: rgba(255, 255, 255, 0.14);
+  --ci-warn: #d9b26f;
+  --ci-danger: #d97a7a;
+  --ci-radius: 1.1vh;
+  // rarity colours (set per item in luxe_cleaninventory's config, or metadata.rarity)
+  --ci-uncommon: #9fc79f;
+  --ci-rare: #8fb0cf;
+  --ci-epic: #b48ad6;
+  --ci-legendary: #d9b26f;
+}
+html.ci-solid { --ci-slot: rgba(22, 22, 24, 0.94); --ci-bg: rgba(22, 22, 24, 0.96); }
+html.ci-none { --ci-slot: rgba(0, 0, 0, 0.25); --ci-bg: rgba(0, 0, 0, 0.25); }
+
+body, #root, #root * { font-family: 'LuxeClean', 'Segoe UI', sans-serif !important; }
+.app-wrapper { color: var(--ci-text); }
+svg { fill: currentColor; }
+
+// ------------------------------------------------ layout
+.inventory-wrapper { gap: 2.4vh; align-items: flex-start; padding-top: 9vh; box-sizing: border-box; }
+.inventory-grid-wrapper { gap: 1vh; }
+.inventory-grid-container { gap: 0.5vh; height: calc(52.1vh + 2vh); }
+
+// ------------------------------------------------ header: title + weight
+.ci-header { text-shadow: 0 1px 6px rgba(0, 0, 0, 0.75); display: flex; justify-content: space-between; align-items: flex-end; gap: 2vh; padding: 0 0.2vh; min-height: 5vh; }
+.ci-title { display: flex; align-items: center; gap: 1.2vh; min-width: 0; }
+.ci-title-icon {
+  display: grid; place-items: center; width: 4.6vh; height: 4.6vh; flex: none;
+  border-radius: 1.2vh; background: var(--ci-bg); border: 1px solid var(--ci-line); color: var(--ci-accent);
+  svg { width: 2.2vh; height: 2.2vh; }
+}
+.ci-title-main { font-size: 2.6vh; font-weight: 700; letter-spacing: -0.01em; line-height: 1.05; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 30vh; }
+.ci-title-sub { font-size: 1.3vh; color: var(--ci-muted); margin-top: 0.2vh; white-space: nowrap; }
+.ci-weight { display: flex; flex-direction: column; align-items: flex-end; gap: 0.6vh; }
+.ci-weight-text {
+  display: flex; align-items: center; gap: 0.6vh; font-size: 1.35vh; font-weight: 600; color: var(--ci-muted); letter-spacing: 0.03em;
+  svg { width: 1.5vh; height: 1.5vh; }
+}
+.ci-segments {
+  display: flex; gap: 0.35vh;
+  span { width: 1.7vh; height: 0.75vh; border-radius: 0.4vh; background: rgba(0, 0, 0, 0.35); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12); transition: background 0.3s; }
+  span.on { background: var(--ci-accent); }
+  &.ci-heavy span.on { background: var(--ci-warn); }
+  &.ci-full span.on { background: var(--ci-danger); }
+}
+
+// ------------------------------------------------ slots
+.inventory-slot, .item-notification-item-box, .hotbar-item-slot {
+  color: var(--ci-text);
+  background-color: var(--ci-slot);
+  border: 1px solid var(--ci-line);
+  border-radius: var(--ci-radius);
+  overflow: hidden;
+  backdrop-filter: blur(6px);
+  background-size: 6.2vh;
+  transition: background-color 0.15s, border-color 0.15s, opacity 0.2s, filter 0.2s;
+}
+.inventory-slot { --ci-rarity: transparent; }
+.inventory-slot:hover { background-color: var(--ci-slot-hover); border-color: rgba(255, 255, 255, 0.16); }
+.inventory-slot.ci-dim { opacity: 0.2 !important; filter: grayscale(1) !important; }
+.item-slot-wrapper { position: relative; z-index: 1; }
+
+// rarity: soft colour from the bottom + a thin border
+@each $tier in uncommon, rare, epic, legendary {
+  .inventory-slot[data-rarity='#{$tier}'] { --ci-rarity: var(--ci-#{$tier}); }
+}
+.inventory-slot.ci-has-item::after {
+  content: ''; position: absolute; inset: 0; pointer-events: none; border-radius: inherit;
+  background: linear-gradient(0deg, color-mix(in srgb, var(--ci-rarity) 42%, transparent), transparent 72%);
+  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ci-rarity) 65%, transparent);
+}
+
+// count + weight badge, top right
+.item-slot-info-wrapper { padding: 0.5vh; }
+.ci-badge {
+  display: inline-flex; align-items: baseline; gap: 0.5vh;
+  padding: 0.2vh 0.7vh; border-radius: 99px;
+  background: rgba(0, 0, 0, 0.45); border: 1px solid var(--ci-line);
+  font-size: 1.15vh; line-height: 1.5;
+  b { font-weight: 700; color: var(--ci-text); }
+}
+.ci-badge-weight { color: var(--ci-muted); font-weight: 500; }
+
+// slot number (1 - 5), top left
+.inventory-slot-number {
+  height: auto; min-width: 1.9vh; padding: 0.2vh 0.6vh; margin: 0.5vh; text-align: center;
+  font-size: 1.15vh; font-weight: 700; line-height: 1.45;
+  background: var(--ci-accent); color: var(--ci-on-accent); border-radius: 0.6vh;
+}
+
+// item name, bottom
+.inventory-slot-label-box { background: none; border: 0; border-radius: 0; color: var(--ci-text); }
+.inventory-slot-label-text {
+  text-transform: none; font-size: 1.3vh; font-weight: 600; padding: 0.3vh 0.6vh 0.6vh;
+  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.85);
+}
+
+// prices in shops
+.item-slot-currency-wrapper p, .item-slot-price-wrapper p { font-weight: 700; font-size: 1.4vh; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8); }
+
+// bars
+.durability-bar { background: rgba(0, 0, 0, 0.35); height: 0.35vh; margin: 0 0.8vh; border-radius: 99px; }
+.durability-bar > div { opacity: 0.9; border-radius: 99px; }
+
+// ------------------------------------------------ search under the inventory
+.ci-search {
+  display: flex; align-items: center; gap: 1vh; height: 4.6vh; padding: 0 1.4vh;
+  background: var(--ci-bg); border: 1px solid var(--ci-line); border-radius: 1.2vh; cursor: text;
+  color: var(--ci-muted);
+  svg { width: 1.8vh; height: 1.8vh; flex: none; }
+  input {
+    flex: 1; min-width: 0; background: transparent; border: 0; outline: none;
+    color: var(--ci-text); font-size: 1.45vh; font-weight: 500;
+    &::placeholder { color: var(--ci-muted); }
+  }
+  &:focus-within { border-color: rgba(255, 255, 255, 0.18); background: var(--ci-solid); }
+}
+.ci-search-clear {
+  background: none; border: 0; color: var(--ci-muted); font-size: 2vh; line-height: 1; cursor: pointer; padding: 0 0.4vh;
+  &:hover { color: var(--ci-text); }
+}
+
+// ------------------------------------------------ status column, left of the inventory
+.ci-status { display: flex; flex-direction: column; gap: 1vh; margin-top: 6vh; }
+.ci-status-tile {
+  --c: var(--ci-text);
+  position: relative; overflow: hidden;
+  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.6vh;
+  width: 8.6vh; height: 8.6vh;
+  background: var(--ci-bg); border: 1px solid var(--ci-line); border-radius: 1.3vh; backdrop-filter: blur(6px);
+  &.ci-low { --c: var(--ci-danger); }
+}
+.ci-status-icon { width: 2.5vh; height: 2.5vh; color: var(--c); }
+.ci-status-health .ci-status-icon, .ci-status-armour .ci-status-icon { color: var(--ci-accent); }
+.ci-low .ci-status-icon { color: var(--ci-danger) !important; }
+.ci-status-value { font-size: 1.45vh; font-weight: 700; color: var(--c); }
+.ci-status-bar {
+  position: absolute; left: 1.2vh; right: 1.2vh; bottom: 0.9vh; height: 0.35vh; border-radius: 99px; background: var(--ci-track); overflow: hidden;
+  i { display: block; height: 100%; width: calc(var(--v) * 1%); background: var(--c); border-radius: inherit; transition: width 0.4s; }
+}
+
+// ------------------------------------------------ amount + buttons in the middle
+.inventory-control { margin-top: 6vh; }
+.inventory-control .inventory-control-wrapper { gap: 1vh; }
+.inventory-control .inventory-control-input {
+  color: var(--ci-text); background-color: var(--ci-bg);
+  border: 1px solid var(--ci-line); border-radius: 1.1vh;
+  padding: 1.5vh 0.8vh; font-size: 1.6vh; font-weight: 600;
+}
+.inventory-control .inventory-control-input:focus-within { background-color: var(--ci-solid); border-color: rgba(255, 255, 255, 0.18); }
+.inventory-control .inventory-control-button {
+  color: var(--ci-text); background-color: var(--ci-bg);
+  border: 1px solid var(--ci-line); border-radius: 1.1vh;
+  padding: 1.4vh 0.8vh; font-size: 1.35vh; font-weight: 700; letter-spacing: 0.08em;
+}
+.inventory-control .inventory-control-button:hover { background-color: var(--ci-accent); color: var(--ci-on-accent); border-color: transparent; }
+
+// ------------------------------------------------ tooltip, right-click menu, help
+.tooltip-wrapper, .context-menu-list, .useful-controls-dialog {
+  color: var(--ci-text); background-color: var(--ci-solid);
+  border: 1px solid var(--ci-line); border-radius: 1.2vh;
+  box-shadow: 0 12px 34px rgba(0, 0, 0, 0.45);
+}
+.tooltip-wrapper { padding: 1vh 1.2vh; }
+.tooltip-header-wrapper p { font-size: 1.45vh; font-weight: 700; color: var(--ci-text); }
+.tooltip-wrapper p { color: var(--ci-muted); }
+.divider { background-color: var(--ci-line); }
+.context-menu-list { padding: 0.5vh; }
+.context-menu-item { color: var(--ci-text); border-radius: 0.8vh; padding: 0.9vh 1vh; font-size: 1.35vh; }
+.context-menu-item:hover { background-color: rgba(255, 255, 255, 0.07); }
+.useful-controls-dialog-close { fill: var(--ci-muted); }
+.useful-controls-dialog-close:hover { background-color: rgba(255, 255, 255, 0.07); }
+.useful-controls-button { background-color: var(--ci-bg) !important; border: 1px solid var(--ci-line) !important; border-radius: 1.2vh !important; color: var(--ci-text); }
+.useful-controls-button:hover { background-color: var(--ci-solid) !important; }
+
+// ------------------------------------------------ hotbar + item notifications
+.hotbar-container, .item-notification-container { gap: 0.6vh; }
+.item-notification-action-box {
+  background: var(--ci-accent); color: var(--ci-on-accent);
+  border-radius: 0; font-weight: 700; letter-spacing: 0.06em;
+  p { font-size: 1.1vh; font-weight: 700; }
+}
+.item-drag-preview { filter: drop-shadow(0 8px 14px rgba(0, 0, 0, 0.5)); }
diff --git a/web/src/luxe/luxe.ts b/web/src/luxe/luxe.ts
new file mode 100644
index 0000000..254b599
--- /dev/null
+++ b/web/src/luxe/luxe.ts
@@ -0,0 +1,91 @@
+// Luxe Clean Inventory: look (accent / background), rarity colours and player status,
+// provided by the luxe_cleaninventory resource. Everything still works without it.
+import { useEffect, useState } from 'react';
+import { fetchResource } from '../utils/fetchNui';
+import { isEnvBrowser } from '../utils/misc';
+
+const RES = 'luxe_cleaninventory';
+export const RARITIES = ['uncommon', 'rare', 'epic', 'legendary'] as const;
+
+function onAccent(hex: string) {
+  const m = String(hex || '').replace('#', '').match(/^([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i);
+  if (!m) return '#141416';
+  const [r, g, b] = m.slice(1).map((x) => parseInt(x, 16) / 255);
+  return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.6 ? '#141416' : '#ffffff';
+}
+
+// item name -> rarity, turned into CSS so slots don't need to re-render when it changes
+function applyRarity(map: Record<string, string>) {
+  let style = document.getElementById('ci-rarity-map') as HTMLStyleElement | null;
+  if (!style) {
+    style = document.createElement('style');
+    style.id = 'ci-rarity-map';
+    document.head.appendChild(style);
+  }
+  const groups: Record<string, string[]> = {};
+  for (const [name, tier] of Object.entries(map || {})) {
+    if (!RARITIES.includes(tier as any)) continue;
+    const safe = name.replace(/["\\]/g, '');
+    (groups[tier] ||= []).push(`.inventory-slot[data-item="${safe}"]:not([data-rarity])`);
+  }
+  style.textContent = Object.entries(groups)
+    .map(([tier, sel]) => `${sel.join(',')}{--ci-rarity:var(--ci-${tier})}`)
+    .join('\n');
+}
+
+let lastTheme = '';
+async function syncTheme() {
+  try {
+    const t: any = await fetchResource(RES, 'theme');
+    const key = JSON.stringify(t);
+    if (key === lastTheme) return;
+    lastTheme = key;
+    const root = document.documentElement;
+    if (t.accent) {
+      root.style.setProperty('--ci-accent', t.accent);
+      root.style.setProperty('--ci-on-accent', onAccent(t.accent));
+    }
+    root.classList.toggle('ci-solid', t.background === 'solid');
+    root.classList.toggle('ci-none', t.background === 'none');
+    applyRarity(t.rarity || {});
+  } catch {
+    /* luxe_cleaninventory isn't running: default look */
+  }
+}
+
+export function startLuxe() {
+  if (isEnvBrowser()) {
+    applyRarity({ coke_pack: 'epic', lockpick: 'uncommon', WEAPON_PISTOL: 'rare', goldbar: 'legendary' });
+    return;
+  }
+  syncTheme();
+  setInterval(syncTheme, 3000);
+}
+
+export type LuxeStatus = { health: number; armour: number; hunger: number; thirst: number; stress?: number };
+
+/** Player status for the column next to the inventory (polled while the inventory is open). */
+export function useLuxeStatus(): LuxeStatus | null {
+  const [status, setStatus] = useState<LuxeStatus | null>(
+    isEnvBrowser() ? { health: 100, armour: 100, hunger: 86, thirst: 89 } : null
+  );
+  useEffect(() => {
+    if (isEnvBrowser()) return;
+    let alive = true;
+    const poll = async () => {
+      try {
+        const s = await fetchResource<LuxeStatus | false>(RES, 'status');
+        if (alive) setStatus(s || null);
+      } catch {
+        if (alive) setStatus(null);
+      }
+    };
+    poll();
+    const id = setInterval(poll, 1000);
+    return () => {
+      alive = false;
+      clearInterval(id);
+    };
+  }, []);
+  return status;
+}
