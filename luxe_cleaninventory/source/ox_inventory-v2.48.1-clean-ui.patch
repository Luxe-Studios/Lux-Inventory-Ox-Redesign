diff --git a/web/src/utils/fetchNui.ts b/web/src/utils/fetchNui.ts
index 2caf667..e4acb0d 100644
--- a/web/src/utils/fetchNui.ts
+++ b/web/src/utils/fetchNui.ts
@@ -38,3 +38,13 @@ export async function fetchNui<T>(eventName: string, data?: unknown): Promise<T>
     throw Error(`Failed to fetch NUI callback ${eventName}! (${error})`);
   }
 }
+
+/** Luxe Clean Inventory: call another resource's NUI callback (uses the real fetch saved above). */
+export async function fetchResource<T>(resource: string, eventName: string, data?: unknown): Promise<T> {
+  const resp = await fetch(`https://${resource}/${eventName}`, {
+    method: 'post',
+    headers: { 'Content-Type': 'application/json; charset=UTF-8' },
+    body: JSON.stringify(data ?? {}),
+  });
+  return resp.json();
+}
